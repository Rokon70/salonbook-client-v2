# MongoDB (same database used by the Express API)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=salonbook

# Better Auth — generate a random secret, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Keep this identical to the API server's AUTH_URL (JWT issuer + JWKS source).
# With the existing deployed server, use its client URL:
BETTER_AUTH_URL=https://salonbook-client-gamma-three.vercel.app
# Browser origin for local preview (trusted, but not the JWT issuer)
BETTER_AUTH_PREVIEW_URL=http://localhost:3001

# Google OAuth (optional). Redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser calls this same-origin path; Next.js proxies it to API_UPSTREAM.
# This avoids CORS when previewing on a different port/domain.
NEXT_PUBLIC_API_URL=/server-api
API_UPSTREAM=http://localhost:5001/api
# Production: API_UPSTREAM=https://<your-server-v2>.vercel.app/api
